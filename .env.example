# Chain / RPC (server + client)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
START_BLOCK=12180054

# Contracts (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_TOKEN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TREASURY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_COINFLIP=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DICE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PLINKO=0x0000000000000000000000000000000000000000

# Wallet connection (Reown AppKit) — get a project id at
# https://dashboard.reown.com and allowlist your production domain there.
# Without it the app falls back to browser-extension wallets only
# (MetaMask/OKX/Rabby via injected); with it, the AppKit modal offers
# WalletConnect (500+ mobile wallets), Coinbase Wallet and email sign-in.
NEXT_PUBLIC_APPKIT_PROJECT_ID=
# Public origin used as the WalletConnect metadata url — must match the
# domain allowlisted in the Reown dashboard.
NEXT_PUBLIC_APP_URL=https://zskazik-web.vercel.app
